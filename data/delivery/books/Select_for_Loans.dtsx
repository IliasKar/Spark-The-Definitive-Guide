            <component
              refId="Package\Load FirstJoinForLoantest\OLE DB Source"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="OLE DB Source"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">select distinct Portfolio.PortfolioName
,ISNULL(AssetLoan.AssetKey, SGKAsset.AssetKey1) AS AccountNumber
,Agreement.AssetKey AS AgreementNumber
,PartyReferenceCodes.CDI AS PrimaryDebtorCDI
,SGKCurrency.CurrencyKey1 Currency
,Bank.Description AS OriginBank
,AssetSegment.Description AssetSegment
,Product.ProductKey
,Product.Description ProductDesc --from profits!
,Product.SubProductDesc    --from Qualco!
,Loan.DenouncedDate
,Loan.ObjectiveStatusDate
,Loan.IsActiveFlag
,LoanMetrics.ClosingDate --Migration --Changed by TBoura on 25/11/2022- CSD-25741 - pr.version Loan.ClosingDate
,Loan.InitialAssignmentAmount -- Static Value - does not change!
,Loan.OpenDate
,Loan.MaturityDate
,Loan.OriginationAmount
,case when Loan.OpenDate IS NOT NULL and Loan.MaturityDate IS NOT NULL THEN DATEDIFF(m, Loan.OpenDate,Loan.MaturityDate) END AS [Tenor]
,Loan.HasActiveSettlementFlag HasSettlement
,Loan.SourceBucketId AS SourceBucket
,Portfolio.spv_qualco_AB SPV
,LoanMetrics.DefaultDateCalculated DefaultDate
,Party.ParentPartyId UnifiedCustomerId
,Loan.LoanId
,Portfolio.PortfolioId
,Party.PartyId
,Agreement.AssetId AS AgreementId
,LoanStatusId
,loan.SourceSystemId
,AccountMechanismId
,InstalmentFrequencyId
,ObjectiveStatusId
,LoanMetrics.LPS AS LoanMetrics_LPS
,PartyMetrics.LPS AS PartyMetrics_LPS
,assetreferencecodes.AssetIdQualco AS assetreferencecodes_AssetIdQualco
,DebtNumber
,Agreement.SigningDate

FROM ast.Loan WITH (READUNCOMMITTED)

INNER JOIN adm.SGKAsset WITH (READUNCOMMITTED)
   on SGKAsset.AssetId=Loan.LoanId

LEFT JOIN adm.AssetReferenceCodes WITH (READUNCOMMITTED)
    ON AssetReferenceCodes.AssetId = Loan.LoanId

INNER JOIN ref.Portfolio  WITH (READUNCOMMITTED)
    ON Portfolio.PortfolioId = Loan.PortfolioId 
	AND Portfolio.CurrentRecord=1
	
LEFT JOIN prt.Party  WITH (READUNCOMMITTED)
    ON Party.PartyId=Loan.CustomerId 
	AND Party.CurrentRecord=1
	
INNER JOIN adm.SGKCurrency WITH (READUNCOMMITTED)
    ON SGKCurrency.CurrencyId=Loan.LoanCurrencyId   
	
LEFT JOIN ast.Asset AssetLoan  WITH (READUNCOMMITTED)
    ON AssetLoan.AssetId=Loan.LoanId 
	AND AssetLoan.CurrentRecord=1
	
LEFT JOIN ast.Asset AS Agreement WITH (READUNCOMMITTED)    
ON Agreement.AssetId=AssetLoan.ParentAssetId 
AND Agreement.CurrentRecord=1

LEFT JOIN ast.Product  WITH (READUNCOMMITTED)
    ON Product.ProductId=Loan.ProductId 
	AND Product.CurrentRecord=1

LEFT JOIN adm.PartyReferenceCodes  WITH (READUNCOMMITTED)
    ON PartyReferenceCodes.PartyId=Party.PartyId

LEFT JOIN cls.Classification AS Bank WITH (READUNCOMMITTED)
    ON Bank.ClassificationId=Portfolio.OriginBankId

LEFT JOIN ast.LoanMetrics WITH (READUNCOMMITTED)
    on LoanMetrics.LoanId=Loan.LoanId 
	and LoanMetrics.CurrentRecord=1

LEFT JOIN cls.Classification AS AssetSegment WITH (READUNCOMMITTED)
    ON AssetSegment.ClassificationId=LoanMetrics.AssetSegmentId

LEFT JOIN prt.PartyMetrics WITH (READUNCOMMITTED)
    on PartyMetrics.PartyId=Party.PartyId 
	and PartyMetrics.CurrentRecord=1

	where Loan.currentrecord= 1</property>
