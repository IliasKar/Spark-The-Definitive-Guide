    <DTS:Executable
      DTS:refId="Package\Load LoanfinancialPartitionLoantest"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{EE57C354-0DAD-496A-9DB3-ED7D6EE0FE68}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Load LoanfinancialPartitionLoantest"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{8EEA9099-787A-45D1-965A-64DF2ED357D2}"
          SQLTask:SqlStatementSource="DECLARE @REFERENCEDATE AS DATE =(SELECT REFERENCEDATE FROM DWH.ADM.SourceExtraction WHERE SourceSystem='Profits');&#xA;&#xA;INSERT INTO [STAGING].[LoanfinancialPartitionLoantest] ([LoanId]&#xA;      ,[PORTFOLIOID]&#xA;      ,[OutstandingTotalBalance]&#xA;      ,[OnBalance]&#xA;      ,[OffBalance]&#xA;      ,[Accruals]&#xA;      ,[Principal]&#xA;      ,[Interest]&#xA;      ,[Expense]&#xA;      ,[GBV]&#xA;      ,[PastDueDaysSource]&#xA;      ,[Delinquent]&#xA;      ,[ReferenceDate]&#xA;      ,[Accrued]&#xA;      ,[DelinquentAccrued]&#xA;&#x9;  ,[BoGBalance])&#xA;&#xA;select DISTINCT LoanFinancials.LoanId&#xA;,PORTFOLIOID&#xA;,LoanFinancials.OutstandingTotalBalance&#xA;,LoanFinancials.OnBalance&#xA;,LoanFinancials.OffBalance&#xA;,LoanFinancials.Accrued+LoanFinancials.DelinquentAccrued Accruals&#xA;,LoanFinancials.Principal + LoanFinancials.DelinquentPrincipal  Principal&#xA;,LoanFinancials.DelinquentInterest + loanfinancials.Interest + loanfinancials.PenaltyInterest + LoanFinancials.PenaltyUnrInterest + loanfinancials.DelinquentUnrInterest +LoanFinancials.UnrealizedInterest Interest&#xA;,LoanFinancials.Expense +LoanFinancials.DelinquentExpense + LoanFinancials.DelinquentComission Expense&#xA;,LoanFinancials.GBV&#xA;,LoanFinancials.PastDueDays as PastDueDaysSource--TBoura--2022-12-30-DEV-6701-- prv PastDueDaysSours&#xA;,LoanFinancials.Delinquent &#xA;,LoanFinancials.ReferenceDate&#xA;,LoanFinancials.Accrued&#xA;,LoanFinancials.DelinquentAccrued&#xA;,LoanFinancials.BoGBalance&#xA;&#xA;FROM DWH.ast.LoanFinancials&#xA;WHERE  ReferenceDate=@REFERENCEDATE" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Load loantest"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{1D61E9B6-4259-4316-BE67-568DAB14BF76}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Load loantest"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{8EEA9099-787A-45D1-965A-64DF2ED357D2}"
          SQLTask:SqlStatementSource="&#xA;INSERT INTO ANALYTIC.STAGING.LOANTEST (PortfolioName&#xA;,AccountNumber&#xA;,AgreementNumber&#xA;,PrimaryDebtorCDI&#xA;,TaxNumber&#xA;,Currency&#xA;,OriginBank&#xA;,GroupCode&#xA;,GroupName&#xA;,AssetSegment&#xA;,ProductKey&#xA;,ProductDesc --from profits!&#xA;,SubProductDesc    --from Qualco!&#xA;, LoanStatus&#xA;,DenouncedDate&#xA;,ObjectiveStatus&#xA;,ObjectiveStatusDate&#xA;,IsActiveFlag&#xA;,ClosingDate --Migration&#xA;,InitialAssignmentAmount -- Static Value - does not change!&#xA;,OutstandingTotalBalance&#xA;,OnBalance&#xA;,OffBalance&#xA;,Accruals&#xA;,SourcePastDueDays --TBoura --2022-12-30 -Dev-6701-- previous version PastDueDays&#xA;,Principal&#xA;,Interest&#xA;,Expense&#xA;,GBV&#xA;,OutstandingTotalBalanceEuro&#xA;,OnBalanceEuro&#xA;,OffBalanceEuro&#xA;, AccrualsEuro&#xA;, GBVEuro&#xA;,OpenDate&#xA;,MaturityDate&#xA;,OriginationAmount&#xA;, [Tenor]&#xA;,AccountMechanism&#xA;,InstalmentFrequency&#xA;,HasSettlement&#xA;,SourceBucket&#xA;,BaseRate&#xA;,SpreadRate&#xA;,PenaltyRate&#xA;,N128Rate&#xA;,InterestRateType&#xA;, Channel&#xA;, LegalChannel&#xA;,  AssignmentProcess&#xA;,CustomerSegment&#xA;, AccountLegalProcessStatus&#xA;, PrimaryDebtorLegalProcessStatus&#xA;, SPV&#xA;,StrategyStep&#xA;, Strategy&#xA;, StrategyArea&#xA;,[Queue]&#xA;, DefaultDate&#xA;, QualcoCurrentlyOpenFlag&#xA;, BalanceArrear&#xA;, BalanceDate&#xA;,LegalProcessStatusName&#xA;, LoanStatusValue&#xA;,UnifiedCustomerId&#xA;,C.LoanId&#xA;,PortfolioId&#xA;,PartyId&#xA;,AgreementId&#xA;,ReferenceDate&#xA;,DebtNumber&#xA;,SigningDate&#xA;,BoGBalance&#xA;,WorkableFlag&#xA;,NonWorkableReason&#xA;,Tranche&#xA;,BoGBalanceEuro)&#xA;&#xA;select distinct UnionJoinForLoantest.PortfolioName&#xA;,[UnionJoinForLoantest].AccountNumber&#xA;,AgreementNumber&#xA;,PrimaryDebtorCDI&#xA;,TaxNumber&#xA;,Currency&#xA;,OriginBank&#xA;,GroupCode&#xA;,GroupName&#xA;,AssetSegment&#xA;,ProductKey&#xA;,ProductDesc --from profits!&#xA;,SubProductDesc    --from Qualco!&#xA;, LoanStatus&#xA;,DenouncedDate&#xA;,ObjectiveStatus&#xA;,ObjectiveStatusDate&#xA;,IsActiveFlag&#xA;,ClosingDate --Migration&#xA;,InitialAssignmentAmount -- Static Value - does not change!&#xA;,OutstandingTotalBalance&#xA;,OnBalance&#xA;,OffBalance&#xA;,Accruals&#xA;,PastDueDaysSource -- as PastDueDays--TBoura 2022-12-30 -- remove alias DEV_6701&#xA;,Principal&#xA;,Interest&#xA;,Expense&#xA;,GBV&#xA;,OutstandingTotalBalanceEuro&#xA;,OnBalanceEuro&#xA;,OffBalanceEuro&#xA;, AccrualsEuro&#xA;, GBVEuro&#xA;,OpenDate&#xA;,MaturityDate&#xA;,OriginationAmount&#xA;, [Tenor]&#xA;,AccountMechanism&#xA;,InstalmentFrequency&#xA;,HasSettlement&#xA;,SourceBucket&#xA;,BaseRate&#xA;,SpreadRate&#xA;,PenaltyRate&#xA;,N128Rate&#xA;,InterestRateType&#xA;, Channel&#xA;, LegalChannel&#xA;,  AssignmentProcess&#xA;,CustomerSegment&#xA;, AccountLegalProcessStatus&#xA;, PrimaryDebtorLegalProcessStatus&#xA;, SPV&#xA;,StrategyStep&#xA;, Strategy&#xA;, StrategyArea&#xA;,[Queue]&#xA;, DefaultDate&#xA;, QualcoCurrentlyOpenFlag&#xA;, BalanceArrear&#xA;, BalanceDate&#xA;,LegalProcessStatusName&#xA;, LoanStatusValue&#xA;,UnifiedCustomerId&#xA;,[ThirdJoinForLoantest] .LoanId&#xA;,PortfolioId&#xA;,PartyId&#xA;,AgreementId&#xA;,[ThirdJoinForLoantest].ReferenceDate&#xA;,DebtNumber&#xA;,SigningDate&#xA;,[ThirdJoinForLoantest].BoGBalance&#xA;,LoanWorkable.WorkableFlag&#xA;,LoanWorkable.NonWorkableReason&#xA;,Tranche&#xA;,[ThirdJoinForLoantest].BoGBalanceEuro&#xA;from [STAGING].[UnionJoinForLoantest] as [UnionJoinForLoantest]&#xA;inner join [STAGING].[ThirdJoinForLoantest] AS [ThirdJoinForLoantest]  on  [UnionJoinForLoantest] .LoanId=[ThirdJoinForLoantest] .LoanId&#xA;left join DWH.ref.Calendar ON Calendar.CalendarDate = [ThirdJoinForLoantest].ReferenceDate --DWH-702--LoanWorkable - Analytic bi.Loan Modifications--join with calendar&#xA;left join bi.LoanWorkable on LoanWorkable.LoanId= [UnionJoinForLoantest].LoanId and LoanWorkable.ReferenceDate=[ThirdJoinForLoantest].ReferenceDate&#xA;and  FrequencyType=case when  calendar.CurrentMonthLastWorkingDate = LoanWorkable.ReferenceDate then 'Monthly' else 'Daily' end  --DWH-702--LoanWorkable - Analytic bi.Loan Modifications-select freq.type" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
