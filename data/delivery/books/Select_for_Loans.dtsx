          SQLTask:SqlStatementSource="INSERT INTO staging.[UnionJoinForLoantest] (&#xA;[PortfolioName]&#xA;      ,[AccountNumber]&#xA;      ,[AgreementNumber]&#xA;      ,[PrimaryDebtorCDI]&#xA;      ,[TaxNumber]&#xA;      ,[Currency]&#xA;      ,[OriginBank]&#xA;      ,[GroupCode]&#xA;      ,[GroupName]&#xA;      ,[AssetSegment]&#xA;      ,[ProductKey]&#xA;      ,[ProductDesc]&#xA;      ,[SubProductDesc]&#xA;      ,[DenouncedDate]&#xA;      ,[ObjectiveStatusDate]&#xA;      ,[IsActiveFlag]&#xA;      ,[ClosingDate]&#xA;      ,[InitialAssignmentAmount]&#xA;      ,[OpenDate]&#xA;      ,[MaturityDate]&#xA;      ,[OriginationAmount]&#xA;      ,[Tenor]&#xA;      ,[HasSettlement]&#xA;      ,[SourceBucket]&#xA;      ,[BaseRate]&#xA;      ,[SpreadRate]&#xA;      ,[PenaltyRate]&#xA;      ,[N128Rate]&#xA;      ,[InterestRateType]&#xA;      ,[Channel]&#xA;      ,[LegalChannel]&#xA;      ,[AssignmentProcess]&#xA;      ,[CustomerSegment]&#xA;      ,[AccountLegalProcessStatus]&#xA;      ,[PrimaryDebtorLegalProcessStatus]&#xA;      ,[SPV]&#xA;      ,[StrategyStep]&#xA;      ,[Strategy]&#xA;      ,[StrategyArea]&#xA;      ,[Queue]&#xA;      ,[DefaultDate]&#xA;      ,[QualcoCurrentlyOpenFlag]&#xA;      ,[LegalProcessStatusName]&#xA;      ,[UnifiedCustomerId]&#xA;      ,[LoanId]&#xA;      ,[PortfolioId]&#xA;      ,[PartyId]&#xA;      ,[AgreementId]&#xA;      ,[DebtNumber]&#xA;      ,[SigningDate]&#xA;&#x9;  ,Tranche)&#xA;&#xA;select DISTINCT PortfolioName&#xA;,AccountNumber&#xA;,AgreementNumber&#xA;,PrimaryDebtorCDI&#xA;,TaxNumber&#xA;,Currency&#xA;,OriginBank&#xA;,GroupCode&#xA;,GroupName&#xA;,AssetSegment&#xA;,ProductKey&#xA;,ProductDesc --from profits!&#xA;,SubProductDesc    --from Qualco!&#xA;,DenouncedDate&#xA;,ObjectiveStatusDate&#xA;,IsActiveFlag&#xA;,ClosingDate --Migration&#xA;,InitialAssignmentAmount -- Static Value - does not change!&#xA;,OpenDate&#xA;,MaturityDate&#xA;,OriginationAmount&#xA;, [Tenor]&#xA;,HasSettlement&#xA;,SourceBucket&#xA;,BaseRate&#xA;,SpreadRate&#xA;,PenaltyRate&#xA;,N128Rate&#xA;,InterestRateType&#xA;, Channel&#xA;, LegalChannel&#xA;,  AssignmentProcess&#xA;,CustomerSegment&#xA;, AccountLegalProcessStatus&#xA;, PrimaryDebtorLegalProcessStatus&#xA;, SPV&#xA;,StrategyStep&#xA;, Strategy&#xA;, StrategyArea&#xA;,[Queue]&#xA;, DefaultDate&#xA;, QualcoCurrentlyOpenFlag&#xA;,LegalProcessStatusName&#xA;,UnifiedCustomerId&#xA;,A.LoanId&#xA;,PortfolioId&#xA;,PartyId&#xA;,AgreementId&#xA;,DebtNumber&#xA;,SigningDate&#xA;,Tranche&#xA;&#x9;from STAGING.[FirstJoinForLoantest] AS A&#xA;&#x9;left outer join STAGING.[SecondJoinForLoantest] AS C on  A.LoanId=C.LoanId&#xA;&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
