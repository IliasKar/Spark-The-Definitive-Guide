                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">--DEV-5664 PopiK 29/12/2022 Light portfolio Addition
--Hotfix PopiK 24/5/23 Double primary owner cases from Qualco SOR - Select unique per AssetID
--DWH-545 Edit channel value for assignment process Collection_Judicial_Escalation
--DWH-2906 Πεδία "Null" για το Portfolio Pearl στον πίνακα Analytic.bi.loan στο server DWHCore MC EG  20250604


SELECT DISTINCT LOAN.LoanId
,PartyIdentification.PartyIdentificationKey AS TaxNumber
,PartyGroup.GroupCode
,PartyGroup.GroupName
,LoanInterestBehaviour.BaseRate
,LoanInterestBehaviour.SpreadRate
,LoanInterestBehaviour.PenaltyRate
,LoanInterestBehaviour.N128Rate
,InterestRateType.Description AS InterestRateType
,case when e.LoanId IS not null then null when Channel.ChannelName='External LF' and AssignmentProcess.Description in ( 'Lf_Offer', 'Collection', 'Collection_Judicial_Escalation',  'N/A', 'DNC_Offer') --DEV-5664 PopiK 29/12/2022 -DWH-545 PopiK 14/7/23 -- DWH-1798 PR 22/12/23
THEN prt.PartyName else Channel.ChannelName end                        as Channel
,case when e.LoanId IS not null then null when Channel.ChannelName='External LF' and AssignmentProcess.Description in ( 'Lf_Offer', 'Collection', 'N/A') --DEV-5664 PopiK 29/12/2022 
THEN NULL else prt.PartyName end                                    as LegalChannel
,case when e.LoanId IS not null then null else AssignmentProcess.Description      end                                  AS AssignmentProcess
,Segment.Description CustomerSegment
,LegalProcessStatus.LegalProcessStatusName AccountLegalProcessStatus --,isnull(LegalProcessStatus.LegalProcessStatusName, LPSGalaxy.LegalProcessStatusName)  AccountLegalProcessStatus
,LPSParty.LegalProcessStatusName PrimaryDebtorLegalProcessStatus
,CaseMaster.StrategyStep
,isnull(strategy_step.strategy_desc,dwh_stg.qca.DIM_STRATEGY_STEP.STR_STEPH1_L3_DESC) Strategy --TBoura - P.Koletsi correction - update strategy desc for QAB as well
,strategy_step.strategy_area_desc StrategyArea
,case when e.LoanId IS not null then null else CaseMaster.[Queue] end as [Queue]
,case when assetreferencecodes_AssetIdQualco IS null then NULL else (case when CaseMaster.AssetId is null then 'No' else 'Yes' end )end QualcoCurrentlyOpenFlag
,LegalProcessStatus.LegalProcessStatusName
,CASE WHEN Segment.Description LIKE '%-B%' THEN 'Tranche B'
      ELSE 'Tranche A' END			Tranche

	FROM ANALYTIC.STAGING.[FirstJoinForLoantest] AS LOAN
	LEFT JOIN act.LegalProcessStatus WITH (READUNCOMMITTED)
    ON LegalProcessStatus.LegalProcessStatusId=LoanMetrics_LPS

LEFT JOIN act.LegalProcessStatus LPSParty  WITH (READUNCOMMITTED) 
on LPSParty.LegalProcessStatusId=PartyMetrics_LPS

LEFT JOIN prt.PartyIdentification  WITH (READUNCOMMITTED)
        ON PartyIdentification.CurrentRecord=1 
		AND PartyIdentificationTypeId in (919,920,12459,21831)
        AND ValidPartyIdentificationFlag=1 
		and PartyIdentification.SourceSystemId=1
        AND PartyIdentification.PartyId=LOAN.PartyId

LEFT JOIN prt.PartyGroup WITH (READUNCOMMITTED)
    ON PartyGroup.PartyId=LOAN.PartyId 
	and PartyGroup.CurrentRecord=1

LEFT JOIN ast.LoanInterestBehaviour WITH (READUNCOMMITTED)
    ON LoanInterestBehaviour.LoanId=Loan.LoanId 
	AND LoanInterestBehaviour.CurrentRecord=1

LEFT JOIN (SELECT Assignment.* FROM dwh.act.Assignment WITH (READUNCOMMITTED) 
			INNER join DWH.ref.Portfolio WITH (READUNCOMMITTED)
				on Portfolio.PortfolioId=Assignment.PortfolioId
			WHERE 1=1
			and Assignment.CurrentRecord=1
			--and (Assignment.PortfolioId &lt;18 or Assignment.PortfolioId in (41,42,52)) --DEV-5664 PopiK 29/12/2022  DWH1602 PR 14/12/2023
			AND vendor_code_qualco is not null AND IsSingleTicketFlag=0 -- MC EG DWH-2906 20250604

) Assignment

on Assignment.LoanId=Loan.LoanId 


left join DWH.ref.Channel WITH (READUNCOMMITTED) 
on Channel.ChannelId=Assignment.AssignmentChannelId 
and Channel.CurrentRecord=1

left join DWH.prt.Party prt WITH (READUNCOMMITTED)  
on Prt.PartyId=Assignment.ExternalCompanyAssignmentId
and prt.CurrentRecord=1

left join DWH.cls.Classification AssignmentProcess WITH (READUNCOMMITTED) 
on AssignmentProcess.ClassificationId=AssignmentProcessId

LEFT JOIN cls.Classification AS InterestRateType WITH (READUNCOMMITTED)
    ON InterestRateType.ClassificationId=LoanInterestBehaviour.InterestRateTypeId

LEFT JOIN prt.CustomerCategory WITH (READUNCOMMITTED) 
on CustomerCategory.PartyId=LOAN.PartyId 
AND CustomerCategory.CurrentRecord=1 and CustomerCategoryTypeId=11026

LEFT JOIN cls.Classification Segment WITH (READUNCOMMITTED) 
on Segment.ClassificationId=CustomerCategory.CustomerCategoryId

LEFT JOIN  (select * from (
select AssetId, Classification.Description as StrategyStep, Classification.Value StrategyStepSourceValue, [Queue].Description [Queue], PortfolioId, casemaster.SourceSystemId,
ROW_NUMBER ()over(partition by AssetId order by casemaster.casecode ) rnk
from ast.CaseMaster WITH (READUNCOMMITTED)
inner join adm.CaseReferenceCodes WITH (READUNCOMMITTED) on CaseReferenceCodes.CaseCode=CaseMaster.CaseCode and CaseReferenceCodes.CurrentRecord=1 and casemaster.SourceSystemId = CaseReferenceCodes.SourceSystemId--and CaseRelationTypeId=15523 
inner join cls.Classification ctp WITH (READUNCOMMITTED) on ctp.ClassificationId = CaseRelationTypeId and Description='Primary Owner'--select based on Primary Owner description - TBoura 2022/10/21
left join cls.Classification WITH (READUNCOMMITTED) on Classification.ClassificationId=CaseMaster.StrategyStepId
left join cls.Classification [Queue] WITH (READUNCOMMITTED) on [Queue].ClassificationId=CaseMaster.QueueId
where CaseMaster.CurrentRecord=1 and CaseMaster.CurrentlyOpenFlag=1 ) as c where c.rnk=1
) CaseMaster
    on CaseMaster.AssetId=Loan.LoanId and CaseMaster.PortfolioId=Loan.PortfolioId

left join dwh_stg.qc.strategy_step WITH (READUNCOMMITTED)
    on cast(strategy_step.strategy_step_id as nvarchar(50))=CaseMaster.StrategyStepSourceValue and CaseMaster.SourceSystemId = 2

left join dwh_stg.qca.DIM_STRATEGY_STEP WITH (READUNCOMMITTED) --TBoura - P.Koletsi correction - update strategy desc for QAB as well
 on cast(DIM_STRATEGY_STEP.STR_STEP_ID as nvarchar(50))=CaseMaster.StrategyStepSourceValue and CaseMaster.SourceSystemId = 12465

left join (
			SELECT COUNT(AssignmentId) cnt,  LoanId
			FROM DWH.act.Assignment WITH (READUNCOMMITTED)
			INNER join DWH.ref.Portfolio WITH (READUNCOMMITTED)
				on Portfolio.PortfolioId=Assignment.PortfolioId
			WHERE Assignment.CurrentRecord = 1 --AND StatusRecord = 1 HotFix 09/08/22 PopiK remove StatusRecord
			--AND (PortfolioId &lt; 18 OR PortfolioId IN (41,42,52)) --DEV-5664 PopiK 29/12/2022    DWH1602 PR 14/12/2023 -- MC EG DWH-2906 20250604
			AND vendor_code_qualco is not null AND IsSingleTicketFlag=0 -- MC EG DWH-2906 20250604

GROUP BY LoanId
HAVING COUNT(1) &gt; 1
)e on e.LoanId=Loan.LoanId</property>
                <property
                  dataType="System.String"
                  description="The variable that contains the SQL command to be executed."
                  name="SqlCommandVariable"></property>
